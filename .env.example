# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values.

# Supabase → Project Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API → "anon" / "publishable" key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → "service_role" / "secret" key.
# SERVER ONLY. Used just to save enquiries after spam checks. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the website (no trailing slash). Used for SEO, sitemap and share cards.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Any long random text. Mixed into the hashed visitor IP used for rate limiting.
ENQUIRY_IP_SALT=change-me-to-a-long-random-string

# OPTIONAL. By default the public site HIDES sample content (example numbers,
# example parent comments, unconfirmed branch hours). Set to "true" only on a
# preview/test deployment to see them with a "Sample" tag.
SHOW_SAMPLE_CONTENT=false
